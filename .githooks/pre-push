#!/bin/sh
if [ "$1" != "origin" ]; then
  echo 'Bu kayıt akışı yalnız doğrulanmış origin bağlantısına gönderir.' >&2
  exit 1
fi
while read local_ref local_oid remote_ref remote_oid
do
  if [ "$local_ref" != "refs/heads/main" ] || [ "$remote_ref" != "refs/heads/main" ]; then
    echo 'Yalnız main dalı gönderilebilir. Eski yerel arşiv dallarını veya etiketleri göndermeyin.' >&2
    exit 1
  fi
  if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
    echo 'main dalını silmek bu kayıt akışında yasaktır.' >&2
    exit 1
  fi
  node tools/github/check.mjs --commit "$local_oid" --ancestor "$remote_oid" || exit 1
done
