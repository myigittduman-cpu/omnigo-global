Options -Indexes
Require all granted
DirectoryIndex index.html
RewriteEngine On
RewriteCond %{HTTP_HOST} !^(portal|yonetim)\.omnigoglobal\.com$ [NC]
RewriteRule ^ - [F,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(portal|yonetim)\.omnigoglobal\.com$ [NC]
RewriteRule ^ https://%1.omnigoglobal.com%{REQUEST_URI} [R=308,L]
RewriteCond %{HTTP_HOST} ^yonetim\.omnigoglobal\.com$ [NC]
RewriteRule ^(?:index\.html)?$ admin-index.html [L]
RewriteRule ^api(?:/.*)?$ api.php [QSA,L]
<FilesMatch "^(?!api\.php$).*\.(php|sql|log|ini|sqlite|env|bak|zip)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://koctas.mirakl.net https://img.pzrmcdn.com; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
Header always set Cache-Control "no-cache"
</IfModule>
