<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="640" Height="528" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" FontSize="13" Foreground="#E5EAF1">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="17,0"/><Setter Property="Foreground" Value="#DDC58D"/><Setter Property="Background" Value="#1B2637"/><Setter Property="BorderBrush" Value="#5D584A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#29374A"/><Setter TargetName="Surface" Property="BorderBrush" Value="#BAA16C"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#DEC382"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Margin="12" CornerRadius="18" BorderBrush="#5C5443" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#223149" Offset="0"/><GradientStop Color="#131F30" Offset="0.65"/><GradientStop Color="#192538" Offset="1"/></LinearGradientBrush></Border.Background><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3"/></Border.Effect>
  <Grid Margin="28,0,28,25"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="124"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="-15,0,-14,0"><Border x:Name="DragArea" Background="Transparent" Margin="0,0,72,0"><TextBlock x:Name="Version" Foreground="#9EACC1" FontSize="11" VerticalAlignment="Center"/></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Minimize" Width="32" Height="30" Padding="0" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Simge durumuna küçült"><Path Data="M 0,0 L 10,0" Stroke="#BEC8D6" StrokeThickness="1.2"/></Button><Button x:Name="Close" Width="32" Height="30" Padding="0" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Kapat"><Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="#BEC8D6" StrokeThickness="1.2"/></Button></StackPanel></Grid>
   <Grid Grid.Row="1" Width="220" Height="124" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"><Image x:Name="Logo" Stretch="Uniform"/><Rectangle x:Name="Shine" Width="220" Height="124" Opacity="0.45"><Rectangle.Clip><RectangleGeometry Rect="0,88,220,23"/></Rectangle.Clip><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="ShineMove" X="-1.6"/></LinearGradientBrush.RelativeTransform><GradientStop Color="#00FFFFFF" Offset="0.2"/><GradientStop Color="#FFFFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="0.8"/></LinearGradientBrush></Rectangle.Fill></Rectangle></Grid>
   <StackPanel Grid.Row="2" Margin="0,15,0,0" HorizontalAlignment="Center"><TextBlock x:Name="ProductName" Foreground="#D6BC80" FontWeight="SemiBold" FontSize="14" TextAlignment="Center"/><TextBlock x:Name="Heading" Text="Kuruluma hoş geldiniz" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0" TextAlignment="Center"/></StackPanel>
   <TextBlock Grid.Row="3" Text="İşletmenizin çalışma alanını bu bilgisayara kurun." Foreground="#ADBBD0" HorizontalAlignment="Center" Margin="0,10,0,0"/>
   <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Kurulum konumu" Foreground="#B7C2D1" FontSize="11" Margin="0,0,0,8"/><TextBox x:Name="Location" IsReadOnly="True" Background="Transparent" Foreground="#D5DEE9" BorderThickness="0" FontSize="12" Padding="0,6,6,6"/></StackPanel><Button x:Name="Browse" Grid.Column="1" Content="Değiştir" Height="34" VerticalAlignment="Bottom" FontSize="12"/></Grid>
   <StackPanel Grid.Row="6" VerticalAlignment="Center" Margin="0,12,0,12"><ProgressBar x:Name="Progress" Height="3" Minimum="0" Maximum="100" Foreground="#D2B97F" Background="#334156" BorderThickness="0" Visibility="Hidden"/><TextBlock x:Name="Status" Text="Yüklemeye hazır." Foreground="#AEBBD0" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" MaxHeight="34"/></StackPanel>
   <Grid Grid.Row="7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Omnigo Global" Foreground="#899AB1" FontSize="11" VerticalAlignment="Center"/><Button x:Name="Install" Grid.Column="1" Content="Kurulumu başlat" FontWeight="SemiBold" MinWidth="156" Height="40"/></Grid>
  </Grid>
 </Border>
</Window>
