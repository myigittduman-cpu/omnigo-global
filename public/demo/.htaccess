Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteCond %{HTTP_HOST} !^portal\.omnigoglobal\.com$ [NC]
RewriteRule ^ - [F,L]
RewriteRule ^assets/(.+)$ /assets/$1 [R=307,L]
<IfModule mod_headers.c>
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-trSEzKoqL9k3oKKtPfMrfrUPFt8zPPnc6a1xpTfXbHw='; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src https://portal.omnigoglobal.com/assets/ https://portal.omnigoglobal.com/vendor/; worker-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
Header always set X-Robots-Tag "noindex, nofollow"
Header always set Cache-Control "no-store"
</IfModule>
